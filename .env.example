# Kalshi API
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com

# Trading mode (always start with paper!)
PAPER_TRADING=true
STARTING_BANKROLL=1000.00

# Runner loop
SCAN_INTERVAL_SECONDS=30
MAX_MARKETS_PER_SCAN=200
KALSHI_ARB_MIN_NET_EDGE=0.02
KALSHI_ARB_SAFETY_MARGIN=0.005

# Data
DB_PATH=data/bot.db
CALIBRATION_DB_PATH=data/calibration.db
LOG_DIR=logs

# Polymarket public APIs
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_LEADERBOARD_URL=https://data-api.polymarket.com
POLYMARKET_CHAIN_ID=137

# Optional offline replay fixtures
POLYMARKET_REPLAY_DIR=

# Polymarket consensus-copy settings
POLYMARKET_TOP_N=10
POLYMARKET_CONSENSUS_K=5
POLYMARKET_LOOKBACK_HOURS=24
POLYMARKET_MIN_WALLET_TRADES=50
POLYMARKET_MIN_WALLET_RESOLVED=20
POLYMARKET_MAX_SLIPPAGE_CENTS=0.02
POLYMARKET_GAS_USD=0.05
POLYMARKET_FRESH_SIGNAL_MINUTES=15
POLYMARKET_MOMENTUM_LOOKBACK_MINUTES=60
POLYMARKET_MOMENTUM_MIN_BUY_TRADES=3
POLYMARKET_MOMENTUM_MIN_WALLETS=2
POLYMARKET_MOMENTUM_MIN_NOTIONAL_USD=500.0
POLYMARKET_MOMENTUM_MIN_PRICE_MOVE=0.03
POLYMARKET_MOMENTUM_MAX_ENTRY_PREMIUM=0.03

# Cross-venue Kalshi/Polymarket spread scanner
CROSS_VENUE_MIN_MATCH_SCORE=0.72
CROSS_VENUE_MIN_SPREAD=0.03

# Weather specialist
WEATHER_OPEN_METEO_ENABLED=true
WEATHER_MIN_EDGE=0.08
WEATHER_SAFETY_BUFFER=0.03
WEATHER_MIN_CONFIDENCE=0.70
WEATHER_AI_ENABLED=false
WEATHER_AI_MODEL=gpt-5-mini
WEATHER_AI_MAX_MARKETS=5
OPENAI_API_KEY=

# Soccer bet builder
ODDS_API_KEY=
ODDS_API_REGION=us
ODDS_API_SPORT_KEY=soccer_fifa_world_cup
SOCCER_ODDS_MARKETS=h2h,totals,btts,alternate_totals,player_goal_scorer_anytime
SOCCER_ODDS_TIMEOUT_S=25
SOCCER_ODDS_VERIFY_SSL=true
SOCCER_AI_GURU_ENABLED=true
SOCCER_AI_GURU_MODEL=gpt-5-mini
